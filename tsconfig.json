{
		"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"strict": true,
		"jsx": "preserve",
		"importHelpers": true,
		"moduleResolution": "node",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"sourceMap": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "@types/mdb-ui-kit",]
		
	},
		"exclude": ["node_modules", "dist"]
	}
